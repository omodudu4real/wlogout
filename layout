{
  "label": "lock",
  "action": "loginctl lock-session",
  "text": "Lock",
  "keybind": "l"
}
{
    "label": "sleep",
    "action": "systemctl suspend",
    "text": "Sleep",
    "keybind": "s"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "Logout",
    "keybind" : "q"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "x"
}






